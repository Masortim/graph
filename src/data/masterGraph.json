      "infoBadge": {
        "content": "🟨 A basis $\\mathcal{B}$ is a linearly independent spanning set.\n🟦 Coordinates $[\\mathbf{x}]_\\mathcal{B}$ uniquely identify vectors in $\\mathbb{R}^n$.",
        "createdAt": "2026-09-18T17:43:08.382Z",
        "updatedAt": "2026-09-18T17:43:08.382Z",
        "scale": 1
      }
    },
    {
