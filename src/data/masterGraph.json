      }
    },
    {
      "id": "ch_4",
      "labelEn": "Chapter 4: Euclidean Spaces & Orthogonality",
      "labelCn": "第4章：欧几里得空间与正交性",
      "type": "chapter",
      "level": 1,
      "clusterId": "ch_4",
      "x": -180,
      "y": 180,
      "vx": 0,
      "vy": 0,
      "radius": 36,
      "baseRadius": 36,
      "weight": 12,
      "color": "#10b981",
      "connectedCount": 5,
      "frequency": 19,
      "sizeLevel": 7,
      "infoBadge": {
        "content": "🟨 Inner product $\\langle \\mathbf{u}, \\mathbf{v} \\rangle$.\n🟦 Orthogonality $\\mathbf{u} \\perp \\mathbf{v} \\iff \\langle \\mathbf{u}, \\mathbf{v} \\rangle = 0$.\n🟩 Gram-Schmidt process & QR Decomposition.",
        "createdAt": "2026-09-18T17:43:08.382Z",
        "updatedAt": "2026-09-18T17:43:08.382Z",
        "scale": 1
      }
    },
    {
      "id": "sec_4_1",
      "labelEn": "Gram-Schmidt Orthogonalization",
      "labelCn": "格拉姆-施密特正交化",
      "type": "section",
      "level": 2,
      "clusterId": "ch_4",
      "chapterId": "ch_4",
      "x": -260,
      "y": 280,
      "vx": 0,
      "vy": 0,
      "radius": 25,
      "baseRadius": 25,
      "weight": 7,
      "color": "#10b981",
      "connectedCount": 3,
      "frequency": 10,
      "sizeLevel": 4,
      "keyPhrases": [
        "gram schmidt",
        "orthonormal basis",
        "projections"
      ],
      "infoBadge": {
        "content": "🟨 $\\mathbf{u}_k = \\mathbf{v}_k - \\sum_{j=1}^{k-1} \\frac{\\langle \\mathbf{v}_k, \\mathbf{u}_j \\rangle}{\\|\\mathbf{u}_j\\|^2} \\mathbf{u}_j$.\n🟦 Produces orthonormal basis $\\mathbf{e}_k = \\frac{\\mathbf{u}_k}{\\|\\mathbf{u}_k\\|}$.",
        "createdAt": "2026-09-18T17:43:08.382Z",
        "updatedAt": "2026-09-18T17:43:08.382Z",
        "scale": 1
      }
    },
    {
