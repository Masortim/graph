      "frequency": 14,
      "sizeLevel": 5,
      "keyPhrases": [
        "linear independence",
        "linear span",
        "basis vectors"
      ],
      "infoBadge": {
        "content": "🟨 **Independence**: $\\sum c_i \\mathbf{v}_i = \\mathbf{0} \\implies c_i = 0$.\n🟦 **Span**: $\\operatorname{span}(\\mathbf{v}_1, \\dots, \\mathbf{v}_k) = \\{ \\sum c_i \\mathbf{v}_i \\}$.",
        "createdAt": "2026-09-18T17:43:08.382Z",
        "updatedAt": "2026-09-18T17:43:08.382Z",
        "scale": 1
      }
    },
    {
      "id": "sec_1_2",
      "labelEn": "Basis and Dimension",
      "labelCn": "基与维数",
      "type": "section",
      "level": 2,
      "clusterId": "ch_1",
