      "infoBadge": {
        "content": "🟨 $\\operatorname{rank}(A)$ equals the number of non-zero pivot rows in REF.\n🟦 Kronecker-Capelli Theorem: Consistent $\\iff \\operatorname{rank}(A) = \\operatorname{rank}(A|\\mathbf{b})$.",
        "createdAt": "2026-09-18T17:43:08.382Z",
        "updatedAt": "2026-09-18T17:43:08.382Z",
        "scale": 1
      }
    },
