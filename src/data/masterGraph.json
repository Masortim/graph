      "infoBadge": {
        "content": "🟨 **Vector Space Axioms**: Closed under addition and scalar multiplication $\\alpha \\mathbf{u} + \\beta \\mathbf{v} \\in V$.\n🟦 Subspaces: $W \\subseteq V$ where $\\mathbf{0} \\in W$.\n🟩 Basis & Dimension: Minimal spanning set $\\dim(V) = n$.",
        "createdAt": "2026-09-18T17:43:08.382Z",
        "updatedAt": "2026-09-18T17:43:08.382Z",
        "scale": 1,
        "language": "cn"
      }
    },
    {
      "id": "sec_1_1",
      "labelEn": "Linear Independence & Span",
      "labelCn": "线性无关与张成空间",
      "type": "section",
      "level": 2,
      "clusterId": "ch_1",
      "chapterId": "ch_1",
      "x": -460,
      "y": -110,
      "vx": 0,
